# open_HAL 環境變數範本（對照計劃書 §11.2）
#
# 使用方式：
#   本機開發 → 複製成 .env（.env 已列入 .gitignore，絕不進版控）
#   Railway  → 在服務的 Variables 頁面逐一填入
#
# 敏感值一律留空或寫 changeme。這個檔案會進版控，任何真實金鑰都不得出現在這裡。
# 變數命名沿用上游的 OPENCLAW_* 前綴，不改名（計劃書 §4）。

# 釘選的上游 OpenClaw 版本；升級時只改這裡，並跑一次 smoke test（計劃書 §13、M6）
# 注意：這是 open_HAL 自己的**建置期參數**（Dockerfile 的 ARG），不是 OpenClaw 認得的
# 執行期變數 —— 官方支援的 OPENCLAW_* 清單裡沒有它（M0 §A2），Gateway 不會讀它。
OPENCLAW_VERSION=2026.9.4

# hal-server（BFF）對外監聽的連接埠。Railway 會自動注入，本機才需要自己設
PORT=8080

# 內部 Gateway 的連接埠，只綁 127.0.0.1，永遠不對外（計劃書 §9）
OPENCLAW_GATEWAY_PORT=18789

# Gateway 的管理密鑰，只有 hal-server 持有，絕不可傳到瀏覽器。請換成隨機長字串
OPENCLAW_GATEWAY_TOKEN=changeme

# OpenClaw 持久化狀態的目錄，對應 Railway Volume 掛載點
OPENCLAW_STATE_DIR=/data/.openclaw

# OpenClaw workspace 目錄（HAL 的人格檔與記憶），同樣要落在 Volume 上
OPENCLAW_WORKSPACE_DIR=/data/workspace

# Agent 大腦（Claude）的 API key（D2）
ANTHROPIC_API_KEY=

# Realtime 語音供應商的 API key（D1，語音進、語音出）
OPENAI_API_KEY=

# 開啟 HAL 臉的通行碼；首次以網址參數 ?k=... 帶入，之後轉為 HttpOnly cookie
HAL_ACCESS_KEY=changeme

# /admin Control UI 的 Basic Auth 帳號（D5 保留此介面供除錯，務必設定）
ADMIN_USER=changeme

# /admin Control UI 的 Basic Auth 密碼，請換成隨機長字串
ADMIN_PASS=changeme

# 喚醒詞引擎（Porcupine Web）的 AccessKey（D3）。
# 由 BFF 於執行期注入頁面，不得寫死在前端原始碼、也不得出現在 build 產物裡
PICOVOICE_ACCESS_KEY=

# 喚醒詞靈敏度，0–1。越高越容易觸發，也越容易誤觸發（建議值由 wake-tune 量測後回填）
HAL_WAKE_SENSITIVITY=0.5

# 對話靜默多少秒後關閉 Realtime session、退回本機喚醒詞監聽（同時也是成本煞車）
HAL_IDLE_TIMEOUT_SEC=45

# 偵測到喚醒詞後，等待使用者真的開口的秒數；逾時就關掉 session 退回監聽。
# 這是喚醒詞誤觸發的第一道成本煞車（計劃書 §6 喚醒方式第 2 點）
HAL_WAKE_ARM_TIMEOUT=5

# 每分鐘允許建立 Realtime session 的次數上限（BFF rate limit，BFF 介面契約 §4.4）。
# 超限時回 rpc:err code rate_limited，是誤觸發時的第二道成本煞車
HAL_MAX_SESSIONS_PER_MIN=6

# Talk 的 sessionKey，由伺服器決定並強制覆寫瀏覽器送來的值（BFF 介面契約 §4.2）。
# 單人使用維持 main 即可；改它等於換一個 agent session（記憶會分家）
HAL_SESSION_KEY=main

# ⚠️ 本機開發逃生門：設為 1 時 hal_key cookie 不帶 Secure 屬性，讓 http://localhost
#    也能通過存取金鑰流程。**正式部署絕對不要設**（設了等於把 cookie 暴露在明文連線上）。
#    預設不設 —— 下面這行刻意保持註解狀態。
# HAL_INSECURE_COOKIE=1
